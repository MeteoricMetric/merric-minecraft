################################################################################
# MeteoricCraft — Environment Configuration (v1.1)
#
# 1. Copy this file:    cp .env.example .env
# 2. Fill in real values for everything marked REQUIRED
# 3. .env is gitignored — never commit it
#
# Cross-references:
#   docs/RUNBOOK.md §1 — change-management ladder (which env edits are 🟢🟡🔴)
#   docs/CHILD-SAFETY-PRIVACY.md §2.1 — what content is acceptable in MOTD
################################################################################

# ── Server identity ─────────────────────────────────────────────────────────
# What players see in their server list before connecting.
# Color codes use § (section sign). §l = bold, §b = aqua, §r = reset.
MOTD=§b§lMeteoricCraft §r§7| §fA Strough family server

# Optional: URL to a 64x64 PNG to use as the server icon
# ICON_URL=https://merricstrough.com/icon-mc.png

# Time zone for log timestamps and backup scheduling
# Find yours: timedatectl list-timezones | grep <region>
TZ=America/New_York

# ── Gameplay ────────────────────────────────────────────────────────────────
MAX_PLAYERS=20
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
DIFFICULTY=normal
MODE=survival
PVP=true

# Optional world seed. Leave blank for random.
# Find seeds at minecraftseeds.net or chunkbase.com
# SEED=-4651105460712845864

# ── Memory ──────────────────────────────────────────────────────────────────
# How much RAM to give the JVM. The container is capped at 8G total in compose.
# 6G is comfortable for 20-player Paper + Geyser + the plugin pack.
#
# CO-TENANCY NOTE (the workstation runs other things too):
#   The Minecraft server shares the workstation with other workloads
#   (Elevare Beats inference, dev tools, etc.). The container's resource
#   limits in docker-compose.yml prevent runaway allocation, but if you
#   notice contention while the server is busy, lower MEMORY here first
#   before raising the container limit.
MEMORY=6G

# ── Whitelist & Ops ─────────────────────────────────────────────────────────
# REQUIRED. Comma-separated, no spaces. Java usernames (Floodgate handles Bedrock).
# Ops have full admin access. Whitelist is who can connect at all.
# Add Bedrock players to whitelist with the . prefix that Floodgate adds.
WHITELIST=ShaneStrough,MeteoricMetric
OPS=ShaneStrough,MeteoricMetric

# ── RCON (admin remote console) ─────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -base64 24
# The RCON port is bound to localhost only — never exposed externally.
RCON_PASSWORD=CHANGEME_RUN_OPENSSL_RAND_BASE64_24

# ── playit.gg tunnel ────────────────────────────────────────────────────────
# REQUIRED before bringing up the playit container. Get from:
# https://playit.gg/account/setup/wizard/new-account/docker/docker-name
PLAYIT_SECRET_KEY=

# ── BlueMap (live web map) ──────────────────────────────────────────────────
# Used for the BlueMap web UI admin panel
BLUEMAP_WEBSERVER_PASSWORD=CHANGEME_RUN_OPENSSL_RAND_BASE64_16

# ── DiscordSRV (event notifications) ────────────────────────────────────────
# DiscordSRV is configured for SERVER-EVENT NOTIFICATIONS ONLY by default,
# NOT chat bridging. This is a child-safety choice — see CHILD-SAFETY-PRIVACY.md §4.
#
# To enable, set these and configure data/plugins/DiscordSRV/config.yml
# AFTER first boot (the plugin generates its config on first run).
#
# Bot token: get from https://discord.com/developers/applications
# Channel ID: right-click the channel in Discord → Copy ID (Developer Mode required)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Switch to "true" only after reading CHILD-SAFETY-PRIVACY.md §4.2
# and explicitly deciding to enable bidirectional chat bridging.
DISCORD_CHAT_BRIDGE_ENABLED=false

# ── Backup configuration ────────────────────────────────────────────────────
# For scripts/backup.sh
# Pick ONE backup target — local OR cloud, not both.

# Option A: Local external drive
RESTIC_REPOSITORY=/mnt/<backup-volume>/minecraft-restic
RESTIC_PASSWORD_FILE=/home/<user>/.restic-password

# Option B: Backblaze B2 (uncomment and fill if using cloud)
# RESTIC_REPOSITORY=b2:meteoriccraft-backups:/restic
# RESTIC_PASSWORD_FILE=/home/<user>/.restic-password
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=

# How many daily snapshots to keep before pruning
BACKUP_RETENTION_DAYS=7
