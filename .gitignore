# Secrets — NEVER commit
.env
.env.local
.env.*.local
*.secret
*.key
*.pem

# Local-only operational specifics (hardware models, exact paths, account names)
# per master CLAUDE.md §15 redaction discipline
CLAUDE.local.md

# Server data — too large for git, lives on disk
data/
backups/
logs/

# OS junk
.DS_Store
Thumbs.db

# Editor noise
.vscode/
.idea/
*.swp
*~

# Restic password
.restic-password

# Claude Code — session-local config only; commit shared config (settings.json, hooks, etc.)
.claude/settings.local.json
.claude/cache/
.claude/file-history/
.claude/projects/
.claude/sessions/
.claude/shell-snapshots/
.claude/statsig/
.claude/telemetry/
.claude/todos/

# Per-agent skill symlink dirs — content lives in .agents/skills/ (committed).
# These hold absolute-path symlinks created by `npx skills add`, which don't
# survive cross-platform clones. Regenerate after clone with:
#   npx skills@latest experimental_install   (uses skills-lock.json)
#   # or: npx skills@latest add mattpocock/skills --skill '*' -y
/.claude/skills/
/skills/
