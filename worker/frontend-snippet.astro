---
/**
 * src/pages/minecraft.astro
 *
 * Drop this into the merricstrough.com repo, replacing the existing
 * /minecraft stub. Live status powered by the Cloudflare Worker
 * deployed from merric-minecraft/worker/.
 *
 * Pattern follows the same conventions as the site's existing
 * Now Spinning widget (per ADR-0001).
 */
import Layout from "../layouts/Layout.astro";

// Update this with your actual deployed worker URL
const STATUS_ENDPOINT = "https://merric-mc-status.<your-subdomain>.workers.dev/status";

const javaAddress = "mc.merricstrough.com";
const bedrockAddress = "<your-playit-bedrock-hostname>";
const bedrockPort = "<your-playit-bedrock-port>";
---

<Layout
  title="MeteoricCraft — Live Server"
  description="MeteoricCraft is a Paper + Geyser Minecraft server hosted by Merric Strough. Java and Bedrock players welcome. Whitelist required."
>
  <main class="mc">
    <header class="mc__header">
      <p class="eyebrow">METEORICCRAFT</p>
      <h1 class="mc__title">
        <span class="status-dot" data-status="loading" aria-hidden="true"></span>
        <span id="status-text">Checking server…</span>
      </h1>
      <p id="motd" class="mc__motd"></p>
    </header>

    <section class="mc__connect">
      <h2 class="eyebrow">HOW TO JOIN</h2>

      <div class="mc__addresses">
        <div class="addr">
          <span class="addr__label">Java Edition</span>
          <code class="addr__value" id="copy-java">{javaAddress}</code>
          <button class="addr__copy" data-copy={javaAddress} aria-label="Copy Java address">copy</button>
        </div>

        <div class="addr">
          <span class="addr__label">Bedrock — Mobile / Win10</span>
          <code class="addr__value">{bedrockAddress}</code>
          <span class="addr__sep">port</span>
          <code class="addr__value">{bedrockPort}</code>
          <button class="addr__copy" data-copy={`${bedrockAddress}:${bedrockPort}`} aria-label="Copy Bedrock address">copy</button>
        </div>
      </div>

      <details class="mc__console">
        <summary>Console support (Xbox / PlayStation / Switch) →</summary>
        <p>Console Bedrock can't directly enter a server address. You'll need <strong>BedrockConnect</strong>, a community workaround:</p>
        <ol>
          <li>Visit <a href="https://bedrockconnect.us" rel="noopener">bedrockconnect.us</a> and grab the DNS server addresses</li>
          <li>Set those DNS values in your console's network settings (manual DNS)</li>
          <li>Launch Minecraft → Servers → BedrockConnect appears as a Featured Server</li>
          <li>Join BedrockConnect and use its menu to enter our server address + port</li>
        </ol>
        <p class="mc__note">This works on home networks but not on most school/corporate WiFi. If it doesn't work, try Bedrock on Windows 10/11 instead — same Microsoft account, same progression.</p>
      </details>

      <p class="mc__note">
        Whitelist only. DM Merric on Discord with your username to be added.
      </p>
    </section>

    <section class="mc__players">
      <h2 class="eyebrow">PLAYERS ONLINE</h2>
      <p class="mc__player-count">
        <span id="player-online">—</span> / <span id="player-max">—</span>
      </p>
      <ul id="player-list" class="mc__player-list" aria-live="polite"></ul>
    </section>

    <section class="mc__rules">
      <h2 class="eyebrow">RULES</h2>
      <ol>
        <li>Don't grief other people's builds. CoreProtect logs everything; rollbacks happen.</li>
        <li>Be cool to Bedrock players. They're playing too.</li>
        <li>No slurs, no real-world drama in chat. Discord bridge is family-friendly.</li>
        <li>Ask before you take from someone's chest. Yes, even if it looks abandoned.</li>
        <li>Bug or grief? Screenshot + tell Merric or Shane.</li>
      </ol>
    </section>

    <p class="mc__updated">
      Live data refreshes every 60s · last checked: <time id="last-checked">—</time>
    </p>
  </main>
</Layout>

<style>
  .mc {
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .mc__header {
    text-align: center;
  }

  .mc__title {
    font-size: clamp(2rem, 5vw + 1rem, 4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-block: var(--space-2) var(--space-3);
  }

  .status-dot {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    background: var(--color-text-muted);
  }
  .status-dot[data-status="online"] {
    background: oklch(74% 0.18 145);
    box-shadow: 0 0 0 0 oklch(74% 0.18 145 / 0.6);
    animation: pulse 2s infinite;
  }
  .status-dot[data-status="offline"] {
    background: oklch(60% 0.22 25);
  }

  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 oklch(74% 0.18 145 / 0.5); }
    70%  { box-shadow: 0 0 0 14px oklch(74% 0.18 145 / 0); }
    100% { box-shadow: 0 0 0 0 oklch(74% 0.18 145 / 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-dot { animation: none; }
  }

  .mc__motd {
    color: var(--color-text-muted);
    font-family: var(--font-stack-mono);
    font-size: 0.95rem;
  }

  .mc__addresses {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-block: var(--space-4);
  }
  .addr {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding: var(--space-3);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }
  .addr__label {
    font-family: var(--font-stack-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    min-width: 8rem;
  }
  .addr__value {
    font-family: var(--font-stack-mono);
    font-size: 1.05rem;
    color: var(--color-text);
  }
  .addr__sep { color: var(--color-text-muted); font-size: 0.85rem; }
  .addr__copy {
    margin-left: auto;
    padding: 0.3rem 0.7rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-accent);
    font-family: var(--font-stack-mono);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.15s;
  }
  .addr__copy:hover { background: var(--color-accent); color: var(--color-bg); }
  .addr__copy[data-copied="true"] { background: oklch(74% 0.18 145); border-color: oklch(74% 0.18 145); color: var(--color-bg); }

  .mc__player-count {
    font-size: 2rem;
    font-family: var(--font-stack-mono);
    margin-block: var(--space-2);
  }
  .mc__player-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .mc__player-list li {
    padding: 0.3rem 0.7rem;
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    font-family: var(--font-stack-mono);
    font-size: 0.85rem;
  }

  .mc__console {
    margin-top: var(--space-4);
    padding: var(--space-3);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }
  .mc__console summary {
    cursor: pointer;
    font-family: var(--font-stack-mono);
    font-size: 0.9rem;
    color: var(--color-accent);
    user-select: none;
    list-style: none;
  }
  .mc__console summary::-webkit-details-marker { display: none; }
  .mc__console[open] summary { margin-bottom: var(--space-2); }
  .mc__console ol {
    padding-inline-start: var(--space-4);
    line-height: 1.7;
    margin-block: var(--space-2);
  }
  .mc__console p { margin-block: var(--space-2); }

  .mc__rules ol {
    padding-inline-start: var(--space-4);
    line-height: 1.8;
  }

  .mc__updated {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    text-align: center;
    margin-top: var(--space-6);
  }

  .mc__note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>

<script define:vars={{ STATUS_ENDPOINT }}>
  const statusDot = document.querySelector(".status-dot");
  const statusText = document.getElementById("status-text");
  const motdEl = document.getElementById("motd");
  const onlineEl = document.getElementById("player-online");
  const maxEl = document.getElementById("player-max");
  const listEl = document.getElementById("player-list");
  const checkedEl = document.getElementById("last-checked");

  async function refresh() {
    try {
      const res = await fetch(STATUS_ENDPOINT, { cache: "no-store" });
      const data = await res.json();

      if (data.online) {
        statusDot.dataset.status = "online";
        statusText.textContent = "Server online";
        motdEl.textContent = (data.motd || "").replace(/§./g, "").trim();
        onlineEl.textContent = data.players?.online ?? "?";
        maxEl.textContent = data.players?.max ?? "?";

        // Default privacy: count only, no names. Per CHILD-SAFETY-PRIVACY.md §2.4.
        // To show names (would require a documented policy update), set
        // SHOW_PLAYER_NAMES = true and adjust the rendering logic below.
        const SHOW_PLAYER_NAMES = false;

        listEl.innerHTML = "";
        const onlineCount = data.players?.online ?? 0;

        if (onlineCount > 0) {
          const li = document.createElement("li");
          if (SHOW_PLAYER_NAMES && Array.isArray(data.players?.sample) && data.players.sample.length > 0) {
            // Show names — only if explicitly enabled
            data.players.sample.forEach((name) => {
              const nameLi = document.createElement("li");
              nameLi.textContent = name;
              listEl.appendChild(nameLi);
            });
          } else {
            // Default — count without names
            li.textContent = onlineCount === 1 ? "1 player on right now" : `${onlineCount} players on right now`;
            listEl.appendChild(li);
          }
        }
      } else {
        statusDot.dataset.status = "offline";
        statusText.textContent = "Server offline";
        motdEl.textContent = "Currently down — check back soon.";
        onlineEl.textContent = "0";
        maxEl.textContent = "—";
        listEl.innerHTML = "";
      }

      const ts = new Date(data.cached_at || Date.now());
      checkedEl.textContent = ts.toLocaleTimeString();
      checkedEl.dateTime = ts.toISOString();
    } catch (err) {
      statusDot.dataset.status = "offline";
      statusText.textContent = "Status unavailable";
      console.error("Status fetch failed:", err);
    }
  }

  // Copy buttons
  document.querySelectorAll(".addr__copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy;
      try {
        await navigator.clipboard.writeText(text);
        btn.dataset.copied = "true";
        const original = btn.textContent;
        btn.textContent = "copied!";
        setTimeout(() => {
          btn.dataset.copied = "false";
          btn.textContent = original;
        }, 1800);
      } catch (err) {
        console.error("Copy failed:", err);
      }
    });
  });

  refresh();
  setInterval(refresh, 60_000);
</script>
